              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/analytics/event": {
      "post": {
        "tags": ["Analytics"],
        "summary": "Log an analytics event",
        "description": "Fire-and-forget: logs events like session_started, session_completed, etc.\nAlways returns 202 even if the log fails silently.",
        "operationId": "log_event_api_v1_analytics_event_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEventIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/donate/url": {
      "get": {
        "tags": ["Donations"],
        "summary": "Donation page URL",
        "description": "Return the trust's donation page URL so the client can open it in a new tab.\nLogs a `donate_link_opened` analytics event so we can track click-through.",
        "operationId": "donate_url_api_v1_donate_url_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyticsEventIn": {
        "properties": {
          "event_name": {
            "type": "string",
            "title": "Event Name"
          },
          "properties": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Properties"
          }
        },
        "type": "object",
        "required": ["event_name"],
        "title": "AnalyticsEventIn"
      },
      "AudioUrlResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "duration": {
            "type": "integer",
            "title": "Duration"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "default": 3600
          }
        },
        "type": "object",
        "required": ["session_id", "duration", "url"],
        "title": "AudioUrlResponse"
      },
      "CancelSubscriptionRequest": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "title": "CancelSubscriptionRequest"
      },
      "FirebaseAuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "id_token": {
            "type": "string",
            "title": "Id Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": ["user", "id_token", "refresh_token", "expires_in"],
        "title": "FirebaseAuthResponse"
      },
      "GuestLoginRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Device Id"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": ["device_id"],
        "title": "GuestLoginRequest"
      },
      "GuestLoginResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": ["user", "access_token"],
        "title": "GuestLoginResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProgramListOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "additionalProperties": true,
            "type": "object",
            "title": "Title"
          },
          "description": {
            "additionalProperties": true,
            "type": "object",
            "title": "Description"
          },
          "total_sessions": {
            "type": "integer",
            "title": "Total Sessions"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          },
          "is_free": {
            "type": "boolean",
            "title": "Is Free"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "kind",
          "title",
          "description",
          "total_sessions",
          "difficulty",
          "is_free"
        ],
        "title": "ProgramListOut"
      },
      "ProgramOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "additionalProperties": true,
            "type": "object",
            "title": "Title"
          },
          "description": {
            "additionalProperties": true,
            "type": "object",
            "title": "Description"
          },
          "total_sessions": {
            "type": "integer",
            "title": "Total Sessions"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          },
          "is_free": {
            "type": "boolean",
            "title": "Is Free"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionOut"
            },
            "type": "array",
            "title": "Sessions",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "kind",
          "title",
          "description",
          "total_sessions",
          "difficulty",
          "is_free",
          "created_at"
        ],
        "title": "ProgramOut"
      },
      "SessionCompletionIn": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "duration_played": {
            "type": "integer",
            "maximum": 60,
            "minimum": 1,
            "title": "Duration Played",
            "description": "Duration in minutes"
          },
          "completion_percentage": {
            "type": "number",
            "maximum": 100,
            "minimum": 0,
            "title": "Completion Percentage"
          }
        },
        "type": "object",
